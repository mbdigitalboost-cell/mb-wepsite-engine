# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Supabase (required) ---------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tracking (optional, leave empty until a customer's real IDs exist) -----
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- Customer CMS connections (Phase 6) --------------------------------------
# One customer Supabase project = one <KEY> suffix, resolved generically by
# lib/cms/connection.ts (never hardcoded per customer in code). <KEY> must
# also exist as an active website's `supabase_connection_key` in the
# Platform DB (supabase/platform/migrations/0001), or the connection is
# treated as "not configured" and every CMS adapter falls back to static
# data — the app never crashes just because these are empty.
#
# Petra Mühendislik (connectionKey = "PETRA") — NOT YET SET. Leave empty
# until a real Petra Supabase project exists; do not fill with placeholder
# values.
SUPABASE_URL_PETRA=
SUPABASE_ANON_KEY_PETRA=
SUPABASE_SERVICE_ROLE_KEY_PETRA=
